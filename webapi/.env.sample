# Smart Watering web API settings. Placeholders only.
# On Azure App Service these are App settings (Configuration > Application settings), not a file.
# Locally: copy to .env (git-ignored) and load it with  node --env-file=.env server.mjs  (Node 20.6+).

# mock = in-memory table for bench tests, dataverse = the real table
MODE=mock
PORT=8080

# Long random value, 24 characters or more. The same value goes into DEVICE_KEY in arduino/CallAPI/secrets.h.
DEVICE_KEY=PASTE_DEVICE_KEY_HERE

# Dataverse mode: app registration (client credentials) whose application user has a read-only role
TENANT_ID=YOUR_TENANT_ID
CLIENT_ID=YOUR_APP_CLIENT_ID
CLIENT_SECRET=YOUR_CLIENT_SECRET
DATAVERSE_URL=https://<your-org>.crm.dynamics.com

# table = query the Switch Command table here, customapi = call the cr_GetSwitchStates Custom API (plugin)
DATAVERSE_READ=table
CUSTOM_API=cr_GetSwitchStates

# Dataverse names, only if yours differ from the sample (publisher prefix cr)
TABLE_SET=cr_switchcommands
COL_SWITCH=cr_switch
COL_STATUS=cr_status
