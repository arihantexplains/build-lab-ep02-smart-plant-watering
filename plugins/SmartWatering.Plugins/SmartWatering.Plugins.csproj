<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>SmartWatering.Plugins</RootNamespace>
    <AssemblyName>SmartWatering.Plugins</AssemblyName>
    <Version>1.0.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Deterministic>true</Deterministic>
    <!-- XML docs on every public member; a missing one is a build warning (CS1591). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Classic plug-in assemblies must be strong-named. Create the key once (see plugins/README.md):
       sn -k key.snk   It is git-ignored; never commit it. Without it the build still works, unsigned. -->
  <PropertyGroup Condition="Exists('key.snk')">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>key.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.56" />
    <!-- Build-time only: lets the project build without the .NET Framework 4.6.2 targeting pack installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.ServiceModel" />
  </ItemGroup>

</Project>
